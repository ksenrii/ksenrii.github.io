// 全站顶栏（timeline 等不经过 mathjax 注入的页面也生效）

ksenr-brand = #35bfab
ksenr-ink = #334f52
ksenr-muted = #66777d

.site-header
    position: fixed
    top: 0
    left: 0
    z-index: 20
    display: flex
    align-items: center
    justify-content: space-between
    width: 100%
    height: 68px
    padding: 0 42px
    background: rgba(255, 255, 255, 0.76)
    border-bottom: 1px solid rgba(255, 255, 255, 0.52)
    backdrop-filter: blur(14px)
    -webkit-backdrop-filter: blur(14px)
    box-shadow: 0 6px 24px rgba(20, 24, 30, 0.06)
    transition: background 180ms ease, box-shadow 180ms ease

.site-header.scrolled
    background: rgba(255, 255, 255, 0.88)
    box-shadow: 0 6px 24px rgba(20, 24, 30, 0.08)

.site-brand
    color: ksenr-ink
    font-weight: 700
    letter-spacing: 0.08em
    text-decoration: none

.site-nav
    display: flex !important
    align-items: center
    gap: 18px

.site-nav a
    position: relative
    display: inline-flex
    align-items: center
    min-height: 34px
    padding: 0 0.1rem
    color: ksenr-muted
    font-size: 14px
    text-decoration: none
    transition: color 0.18s ease

.site-nav a::after
    content: ""
    position: absolute
    left: 0
    right: 0
    bottom: 2px
    height: 2px
    transform: scaleX(0)
    transform-origin: right
    border-radius: 999px
    background: ksenr-brand
    transition: transform 0.18s ease

.site-nav a:hover
    color: ksenr-brand

.site-nav a:hover::after
    transform: scaleX(1)
    transform-origin: left

@media screen and (max-width: 719px)
    .site-header
        height: auto
        min-height: 56px
        padding: 14px 18px
        align-items: flex-start

    .site-nav
        flex-wrap: wrap
        justify-content: flex-end
        gap: 10px 14px
